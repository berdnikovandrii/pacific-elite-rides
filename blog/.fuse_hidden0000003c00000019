<section class="section" style="padding-top:32px">
  <div class="container">
    <div style="max-width:760px;margin:0 auto">
      <img src="../web-photos/fleet-week-san-diego-2026-hero.jpg" alt="Fleet Week San Diego 2026: Getting Downtown for the Parade, Ship Tours, and Big Bay Boom Without a Parking Nightmare" loading="eager"
